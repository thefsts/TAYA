#!/usr/bin/env bash
# pre-push — blocks pushes containing commits with unauthorized identity.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue # deleting a ref — nothing to check
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    range="$local_sha" # new branch: check reachable commits from tip (last 50)
    bash "$repo_root/scripts/check-commit-identity.sh" "${local_sha}~50..${local_sha}" 2>/dev/null \
      || bash "$repo_root/scripts/check-commit-identity.sh" "$local_sha"
  else
    bash "$repo_root/scripts/check-commit-identity.sh" "${remote_sha}..${local_sha}"
  fi
done

#!/bin/sh
# ── Identity enforcement ───────────────────────────────────────────────────
# Unconditionally write the approved identity to git config so git picks it
# up when GIT_AUTHOR_* / GIT_COMMITTER_* are not injected by the platform.
git config user.name  "THEFSTS"
git config user.email "amorebey@gmail.com"

# Read the effective author identity that git will actually use.
# git var honours GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL env vars (which take
# precedence over config), so this reflects the real author the commit carries.
AUTHOR_IDENT="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
COMMITTER_IDENT="$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"

APPROVED_NAME="THEFSTS"
APPROVED_EMAIL="amorebey@gmail.com"

# ── Author check (hard failure) ────────────────────────────────────────────
# Vercel and GitHub match commits by author email; a wrong author blocks CI.
case "$AUTHOR_IDENT" in
  "THEFSTS <amorebey@gmail.com>"*) ;;
  *)
    echo "✗ pre-commit: author identity is not approved." >&2
    echo "  effective author: $AUTHOR_IDENT" >&2
    echo "  required:         $APPROVED_NAME <$APPROVED_EMAIL>" >&2
    echo "" >&2
    echo "  Set the approved identity before committing:" >&2
    echo "    export GIT_AUTHOR_NAME='$APPROVED_NAME'" >&2
    echo "    export GIT_AUTHOR_EMAIL='$APPROVED_EMAIL'" >&2
    exit 1
    ;;
esac

# ── Committer check (warning only, non-blocking) ───────────────────────────
# The Replit platform's merge/sync layer may inject GIT_COMMITTER_* env vars
# that override git config; committer identity is outside task-agent control.
# Vercel does not use committer email for account matching.
case "$COMMITTER_IDENT" in
  "THEFSTS <amorebey@gmail.com>"*) ;;
  *)
    echo "WARN: pre-commit: committer identity differs (platform sync — non-blocking)." >&2
    echo "  effective committer: $COMMITTER_IDENT" >&2
    ;;
esac

# ── Corsair guard ──────────────────────────────────────────────────────────
# Reject any staged file under corsair-source/
staged=$(git diff --cached --name-only | grep '^corsair-source/')
if [ -n "$staged" ]; then
  echo ""
  echo "✗ pre-commit: corsair-source/ files are staged for commit."
  echo "  These files must never be committed to this repository."
  echo ""
  echo "  Staged files:"
  echo "$staged" | sed 's/^/    /'
  echo ""
  echo "  To unstage them:  git reset HEAD corsair-source/"
  echo "  To stop tracking: git rm -r --cached corsair-source/"
  echo ""
  exit 1
fi

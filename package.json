{
  "name": "workspace",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "prepare": "bash scripts/install-hooks.sh",
    "build": "pnpm run validate:catalog && pnpm run typecheck && pnpm -r --if-present run build",
    "validate:catalog": "pnpm --filter @workspace/scripts run validate:catalog",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:design-lock": "pnpm --filter @workspace/design-lock-tests run test",
    "test:health-monitor": "pnpm --filter @workspace/health-monitor-tests run test",
    "test:visual": "pnpm --filter @workspace/visual-regression run test",
    "test:visual:update": "pnpm --filter @workspace/visual-regression run test:update",
    "test:visual:report": "pnpm --filter @workspace/scripts run visual-diff-report",
    "test:pricing": "pnpm --filter @workspace/pricing-tests run test",
    "test:convex-unit": "pnpm --filter @workspace/convex-unit run test",
    "test:e2e": "pnpm --filter @workspace/e2e run test",
    "test:e2e:report": "pnpm --filter @workspace/e2e run test:report",
    "test:corsair-e2e": "pnpm --filter @workspace/corsair-e2e run test",
    "test:corsair-e2e:report": "pnpm --filter @workspace/corsair-e2e run test:report",
    "test:corsair-guard": "bash scripts/check-corsair-guard.sh",
    "test:hook-guard": "bash scripts/test-hook-guard.sh"
  },
  "packageManager": "pnpm@10.26.1",
  "private": true,
  "devDependencies": {
    "@types/sharp": "^0.32.0",
    "convex": "^1.25.4",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "sharp": "^0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "^0.35.3"
  }
}
